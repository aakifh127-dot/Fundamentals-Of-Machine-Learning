import numpy as np
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures
from sklearn.metrics import mean_squared_error

# Dataset
X = np.array([[1], [2], [3], [4], [5], [6]])
y = np.array([10, 15, 25, 40, 60, 85])

# Linear Regression
linear = LinearRegression()
linear.fit(X, y)
linear_pred = linear.predict(X)

# Polynomial Regression
poly = PolynomialFeatures(degree=2)
X_poly = poly.fit_transform(X)

model = LinearRegression()
model.fit(X_poly, y)
poly_pred = model.predict(X_poly)

# Calculate errors
linear_error = mean_squared_error(y, linear_pred)
poly_error = mean_squared_error(y, poly_pred)

# Display results
print("Linear Regression Predictions:", np.round(linear_pred, 2))
print("Polynomial Regression Predictions:", np.round(poly_pred, 2))

print("Linear Regression MSE:", round(linear_error, 2))
print("Polynomial Regression MSE:", round(poly_error, 2))
