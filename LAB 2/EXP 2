import csv

with open("candidate.csv") as f:
    data = list(csv.reader(f))[1:]

S = ['0'] * 6
G = [['?'] * 6]

for row in data:
    x = row[:-1]

    if row[-1] == "Yes":
        for i in range(6):
            if S[i] == '0':
                S[i] = x[i]
            elif S[i] != x[i]:
                S[i] = '?'

    else:
        newG = []

        for g in G:
            for i in range(6):
                if S[i] != '?' and S[i] != '0' and S[i] != x[i]:
                    h = g.copy()
                    h[i] = S[i]
                    newG.append(h)

        G = newG

print("Specific Hypothesis:", S)
print("General Hypothesis:")

for g in G:
    print(g)
