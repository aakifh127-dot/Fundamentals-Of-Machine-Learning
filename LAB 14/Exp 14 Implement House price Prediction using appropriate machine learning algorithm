import numpy as np
from sklearn.linear_model import LinearRegression

# Dataset: Area in square feet
X = np.array([[500], [800], [1000], [1200], [1500]])

# Price in lakhs
y = np.array([15, 24, 30, 36, 45])

# Train model
model = LinearRegression()
model.fit(X, y)

# Predict price
price = model.predict([[1100]])

print("Predicted House Price:", round(price[0], 2), "Lakhs")
